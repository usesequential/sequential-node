{
    "name": "@usesequential/node",
    "version": "1.0.4",
    "description": "Send your backend's events and errors to Sequential, on the same person and browser session as their browser events.",
    "keywords": [
        "sequential",
        "analytics",
        "session replay",
        "server-side",
        "events",
        "error tracking"
    ],
    "homepage": "https://www.usesequential.com/docs/backend-sdk",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/usesequential/sequential-node.git"
    },
    "bugs": {
        "url": "https://github.com/usesequential/sequential-node/issues"
    },
    "license": "MIT",
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "node scripts/build.cjs",
        "test": "jest",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "smoke": "node scripts/smoke.cjs",
        "prepublishOnly": "node scripts/build.cjs && node scripts/smoke.cjs"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/jest": "29.5.14",
        "@types/node": "22.20.4",
        "jest": "29.7.0",
        "ts-jest": "29.4.0",
        "typescript": "5.7.3"
    }
}
