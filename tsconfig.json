{
    // The package build (scripts/build.cjs runs it twice: CommonJS and ES modules).
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2022", "DOM"],
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "declaration": false,
        "skipLibCheck": true,
        "types": ["node"],
        "rootDir": "./src",
        "outDir": "./dist/cjs"
    },
    "include": ["src/**/*"]
}
